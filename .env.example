NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
ALLOWED_GOOGLE_DOMAIN=mclinkgroup.com
SESSION_SECRET=replace-with-at-least-32-random-characters
# Reuses GOOGLE_CLIENT_ID above (same OAuth client, "Web application" type)
# for the HOD Google Calendar connection flow. That client needs a secret
# and this exact redirect URI added under "Authorized redirect URIs" in
# Google Cloud Console, plus the Google Calendar API enabled on the project.
# Calendar connections request event creation and free/busy checking; HODs
# must reconnect after the scope changes if they were connected previously.
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-the-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback
# Server-only n8n endpoints and secret. The browser must never receive these.
N8N_ROLE_WEBHOOK_URL=https://your-n8n-domain/webhook/role-request
N8N_ROLE_REQUEST_WEBHOOK_URL=https://your-n8n-domain/webhook/role-request
N8N_ROLE_DESCRIPTION_PARSER_WEBHOOK_URL=https://your-n8n-domain/webhook/role-description-parser
N8N_RECRUITMENT_SETUP_WEBHOOK_URL=https://your-n8n-domain/webhook/recruitment-setup
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
N8N_CANDIDATE_APPLICATION_WEBHOOK_URL=https://your-n8n-domain/webhook/candidate-application
N8N_BULK_RESUME_UPLOAD_WEBHOOK_URL=https://your-n8n-domain/webhook/bulk-resume-upload
# Shared Google Drive destination for the bulk resume screening panel.
GOOGLE_BULK_RESUME_DRIVE_URL=https://drive.google.com/drive/folders/your-bulk-resume-folder-id
# Folder ID used by the n8n Drive poller; configure this in the n8n environment.
GOOGLE_BULK_RESUME_DRIVE_FOLDER_ID=your-bulk-resume-folder-id
# Public portal origin reachable by n8n for PDF/DOCX text extraction.
N8N_BULK_RESUME_PORTAL_BASE_URL=https://your-portal-domain
# Google Sheets service-account configuration; keep the private key server-only.
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# Optional separate workbook for the ELLA applicant pipeline.
GOOGLE_CANDIDATE_SPREADSHEET_ID=your-candidate-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_APP_NAME=McLink Recruitment Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Final booking tokens are single-use; this controls the initial pending lifetime.
BOOKING_LINK_EXPIRY_DAYS=7
# Private storage for uploaded PDF/DOC/DOCX resumes, backed by Google Drive
# (not local disk — Vercel's filesystem is read-only outside /tmp). Share this
# folder with GOOGLE_SERVICE_ACCOUNT_EMAIL (Editor access) before setting this
# — a Shared Drive folder is strongly preferred, since a service account has
# no storage quota of its own and uploads fail without one.
RESUME_STORAGE_DRIVE_FOLDER_ID=
# Client-demo mode. When "true", the portal shows synthetic recruitment data
# only and becomes read-only for applicant-facing actions. Live applicant
# emails, phone calls, booking reservations, decisions, and Google Calendar
# writes are refused. Enable this only in the demo deployment.
DEMO_MODE=false
# Optional legacy cutoff retained for compatibility with older integrations.
DEMO_CUTOFF=
